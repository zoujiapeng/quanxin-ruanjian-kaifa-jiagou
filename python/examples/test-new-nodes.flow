{"meta":{"id":"test-advanced-nodes","name":"高级节点功能测试","description":"测试全部6个新增高级节点：OCR点击文本、关闭弹窗、颜色检测、等待进度、等待区域变化、场景识别","created_at":"2026-05-02T18:00:00.000Z","updated_at":"2026-05-02T18:00:00.000Z","version":"1.0.0"},"nodes":[{"id":"n1","type":"start","x":400,"y":20,"params":{"label":"开始"},"status":"idle"},{"id":"n2","type":"click_text","x":400,"y":150,"params":{"text":"点击这里","similarity":80,"method":"single","offset_x":0,"offset_y":0,"timeout":10,"delay_after":0.5,"description":"点击测试窗口中的可变化文字"},"label":"OCR点击文字","status":"idle"},{"id":"n3","type":"wait","x":400,"y":280,"params":{"wait_type":"time","duration":1,"description":"等待文字变化"},"label":"等待1秒","status":"idle"},{"id":"n4","type":"click_text","x":400,"y":410,"params":{"text":"测试点击","similarity":85,"method":"double","offset_x":0,"offset_y":0,"timeout":10,"delay_after":0.5,"description":"双击变化后的文字"},"label":"OCR双击文字","status":"idle"},{"id":"n5","type":"progress_wait","x":400,"y":540,"params":{"wait_type":"fill","timeout":30,"region":{"x":0,"y":0,"w":200,"h":20},"poll_interval":0.5,"description":"等待进度条填满"},"label":"等待进度条","status":"idle"},{"id":"n6","type":"color_check","x":400,"y":670,"params":{"x":100,"y":100,"w":50,"h":50,"expected_color":"0,255,0","tolerance":30,"description":"检测区域是否为绿色"},"label":"颜色检测","status":"idle"},{"id":"n7","type":"region_wait","x":400,"y":800,"params":{"region_type":"stable","x":0,"y":0,"w":300,"h":300,"timeout":15,"poll_interval":0.3,"description":"等待屏幕区域稳定"},"label":"等待区域稳定","status":"idle"},{"id":"n8","type":"popup_close","x":400,"y":930,"params":{"strategies":["auto"],"timeout":5,"delay_after":0.3,"description":"自动关闭弹窗"},"label":"关闭弹窗","status":"idle"},{"id":"n9","type":"scene_condition","x":400,"y":1060,"params":{"scene_name":"测试场景","similarity":70,"description":"场景识别判断"},"label":"场景识别","status":"idle"},{"id":"n10","type":"end","x":250,"y":1180,"params":{"label":"匹配成功"},"label":"匹配成功","status":"idle"},{"id":"n11","type":"end","x":550,"y":1180,"params":{"label":"不匹配"},"label":"不匹配","